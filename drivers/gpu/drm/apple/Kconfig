config DRM_APPLE_M4_DCPEXT
	bool "Apple M4 J713 external DisplayPort"
	depends on DRM=y && ARM64 && ARCH_APPLE && OF && ARM64_16K_PAGES
	depends on TYPEC_SN201202X=y
	select MFD_SYSCON
	select DRM_KMS_HELPER
	select DRM_GEM_DMA_HELPER
	help
	  Build the J713 external display runtime into the kernel. Requires the
	  reserved firmware and DART handoff from the M4 bootloader. The driver
	  waits for a supported USB-C display connection without blocking boot,
	  then publishes a DRM connector with monitor identity and modes.
	  Shutdown is handled by the kernel; no explicit module load is needed.
	  Sleep, firmware restart and broader display features remain unsupported.

config DRM_APPLE_M4_DCPEXT_AUDIO
	tristate "Apple M4 J713 external display audio"
	depends on DRM_APPLE_M4_DCPEXT && SND && APPLE_SIO
	select SND_DMAENGINE_PCM
	help
	  PCM playback through the M4 DCP audio service and SIO DMA.
	  Initial qualification supports stereo 48 kHz S16_LE on DCPEXT0.
	  Does not enable the laptop's internal speakers or headphone codec.

config DRM_APPLE
	tristate "DRM Support for Apple display controllers"
	depends on DRM && OF && ARM64
	depends on ARCH_APPLE || COMPILE_TEST
	depends on APPLE_RTKIT
	depends on OF_ADDRESS
	select APPLE_PMP_REPORT
	select DRM_CLIENT_SELECTION
	select DRM_KMS_HELPER
	select DRM_KMS_DMA_HELPER
	select DRM_GEM_DMA_HELPER
	select VIDEOMODE_HELPERS
	depends on BACKLIGHT_CLASS_DEVICE
	select MULTIPLEXER
	help
	  Say Y if you have an Apple Silicon chipset.

config DRM_APPLE_AUDIO
	bool "DisplayPort/HDMI Audio support"
	default y
	depends on DRM_APPLE
	depends on SND
	select SND_PCM
	select SND_DMAENGINE_PCM

config DRM_APPLE_DEBUG
	bool "Enable additional driver debugging"
	depends on DRM_APPLE
	depends on EXPERT # only for developers

config DRM_APPLE_KUNIT_TEST
	tristate "KUnit tests for the Apple display driver" if !KUNIT_ALL_TESTS
	depends on DRM_APPLE && KUNIT
	default KUNIT_ALL_TESTS
	help
	  Build focused unit tests for Apple display lifecycle helpers and DCPLink
	  message encoders. The tests do not access display hardware. If in doubt,
	  say "N".
