 //! Byte-bounded storage for fully retired, displaced command owners.
 //! Firmware's last owner and in-flight commands must never enter this cache.
 use kernel::prelude::*;
+use core::sync::atomic::{AtomicUsize, Ordering};
 
-pub(crate) const CACHE_BYTES: usize = 128 * 1024 * 1024;
+// One bound for every queue and both engines. A frame with many render passes
+// needs more than three 32 MiB owners; a small per-queue FIFO thrashes on every
+// frame. Sharing the budget permits that working set without multiplying the
+// maximum idle retention by the number of clients. Active/firmware-retained
+// owners remain outside this cache and retain their exact lifetime rules.
+pub(crate) const CACHE_BYTES: usize = 1536 * 1024 * 1024;
+static CACHED_BYTES: AtomicUsize = AtomicUsize::new(0);
+
+fn try_charge(bytes: usize) -> bool {
+    CACHED_BYTES.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |used| {
+        (used <= CACHE_BYTES - bytes).then(|| used + bytes)
+    }).is_ok()
+}
 
 pub(crate) struct OwnerCache<T> {
     entries: KVec<(usize, T)>,
@@ -19,6 +32,7 @@ pub(crate) fn take(&mut self, matches: impl Fn(&T) -> bool) -> Option<T> {
         let index = self.entries.iter().position(|(_, owner)| matches(owner))?;
         let (bytes, owner) = self.entries.remove(index).ok()?;
         self.bytes -= bytes;
+        CACHED_BYTES.fetch_sub(bytes, Ordering::Relaxed);
         Some(owner)
     }
 
@@ -26,13 +40,22 @@ pub(crate) fn put(&mut self, owner: T, bytes: usize) {
         // Large scenes remain legal; they simply bypass the idle cache.
         // Subtraction also avoids overflowing when given a very large owner.
         if bytes > CACHE_BYTES { return; }
-        while self.bytes > CACHE_BYTES - bytes {
+        while !try_charge(bytes) {
             let Ok((old_bytes, old)) = self.entries.remove(0) else { return; };
             self.bytes -= old_bytes;
+            CACHED_BYTES.fetch_sub(old_bytes, Ordering::Relaxed);
             drop(old);
         }
         if self.entries.push((bytes, owner), GFP_KERNEL).is_ok() {
             self.bytes += bytes;
+        } else {
+            CACHED_BYTES.fetch_sub(bytes, Ordering::Relaxed);
         }
     }
 }
+
+impl<T> Drop for OwnerCache<T> {
+    fn drop(&mut self) {
+        CACHED_BYTES.fetch_sub(self.bytes, Ordering::Relaxed);
+    }
+}
